<%- contentFor('body') %>
<!-- Edit Container -->
<article class="edit-container">
  <header class="edit-header">
    <h1>Edit Post</h1>
  </header>

  <form action="/posts/<%= post.id %>/update" method="POST" class="edit-form">
    <!-- CSRF token -->
    <input type="hidden" name="x-csrf-token" value="<%= csrfToken %>" />

    <div class="form-group">
      <label for="title">Title</label>
      <input
        type="text"
        id="title"
        name="NewPostTitle"
        value="<%= post.title %>"
        required
        class="form-input"
      />
    </div>

    <div class="form-group">
      <label for="content">Content</label>
      <textarea
        id="content"
        name="NewPostContent"
        required
        class="form-textarea"
      >
      <%= post.content %></textarea
      >
    </div>

    <footer class="edit-footer">
      <button type="submit" class="btn-save">
        <img src="/svgs/save_post.svg" alt="" aria-hidden="true" />
        <span>Save Changes</span>
      </button>
      <a href="/posts/<%= post.id %>" class="btn-cancel">
        <img src="/svgs/cancel_edit.svg" alt="" aria-hidden="true" />
        <span>Cancel</span>
      </a>
    </footer>
  </form>
</article>
