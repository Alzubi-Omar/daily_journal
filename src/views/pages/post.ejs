<%- contentFor('body') %>

<!-- Post Container -->
<article class="post-container">
  <header class="post-header">
    <h1 class="post-title"><%= post.title %></h1>
    <div class="post-meta">
      <span class="post-author">By <%= post.name %></span>
      <span class="divider" aria-hidden="true">•</span>
      <time class="post-date" datetime="<%= new Date(post.created_at).toISOString() %>">
        <%= new Date(post.created_at).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        }) %>
      </time>
    </div>
  </header>


  <div class="post-content">
    <%= post.content %>
  </div>

  <footer class="post-footer">
    <div class="post-actions">
      <a href="/posts/<%= post.id %>/edit" class="btn btn-primary" title="Edit this post">
        <img src="/svgs/edit_post.svg" alt="" aria-hidden="true" />
        <span>Edit</span>
      </a>
      <a
        href="/posts/<%= post.id %>/delete"
        class="btn btn-danger"
        role="button"
        aria-label="Delete this post"
      >
        <img src="/svgs/delete_post.svg" alt="" aria-hidden="true" />
        <span>Delete</span>
      </a>
    </div>
    <a href="/blogs" class="btn btn-secondary">
      <img src="/svgs/read_all.svg" alt="" aria-hidden="true" />
      <span>All Posts</span>
    </a>
  </footer>
</article>
