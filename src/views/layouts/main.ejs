<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="<%= typeof meta !== 'undefined' ? meta.description : 'Welcome to Daily Journal.' %>"
    />
    <title>
      <%= typeof meta !== 'undefined' ? meta.title : 'Daily Journal' %>
    </title>

    <!-- Preload critical resources -->
    <link rel="preload" href="/styles/styles.css" as="style" />

    <!-- Base CSS -->
    <link rel="stylesheet" href="/styles/styles.css" />

    <!-- Page-specific CSS -->
    <% if (Array.isArray(locals.styles) && locals.styles.length > 0) { %>
      <% styles.forEach(function(style) { %>
        <link rel="stylesheet" href="/styles/<%= style %>.css" />
      <% }); %>
    <% } %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-wrapper">

      <%- include('../partials/header') %>

      <!-- Flash messages -->
      <% if (locals.messages && messages.success && messages.success.length > 0) { %>
        <div id="flash-message" class="flash-message success" role="status" aria-live="polite">
          <p><%= messages.success %></p>
        </div>
      <% } %>

      <main><%- body %></main>

      <%- include('../partials/footer') %>

      <!-- Base scripts -->
      <script src="/js/main.js" defer></script>

      <!-- Page-specific scripts -->
      <% if (Array.isArray(locals.scripts) && locals.scripts.length > 0) { %>
        <% scripts.forEach(function(script) { %>
          <script src="/js/<%= script %>.js" defer></script>
        <% }); %>
      <% } %>
    </div>
  </body>
</html>
